{
  "name": "mole-desktop",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "An independent Windows desktop interface with reviewed, opt-in maintenance for Mole",
  "author": "ZhangFeiii",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build:agent": "node scripts/build-agent.cjs",
    "build:integrity": "node scripts/integrity-manifest.cjs",
    "build:ui": "tsc --noEmit && vite build",
    "build": "npm run build:agent && npm run build:integrity && npm run build:ui",
    "verify:integrity": "node scripts/integrity-manifest.cjs --check",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:packaged": "node --test tests/packaged-runtime.test.cjs",
    "test:e2e": "playwright test",
    "package:win": "npm run build && electron-builder --win portable --x64 --publish never",
    "package:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "build": {
    "appId": "io.github.zhangfeiii.mole.desktop",
    "productName": "Mole Desktop",
    "artifactName": "Mole-Desktop-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD-PARTY-NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "windows",
        "to": "windows",
        "filter": [
          "*.ps1"
        ]
      },
      {
        "from": "resources",
        "to": "agent",
        "filter": [
          "desktop-agent*",
          "licenses/**/*"
        ]
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    },
    "win": {
      "target": [
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker",
      "signExecutable": false,
      "signExts": [
        ".dll",
        "!desktop-agent.exe"
      ]
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.utilities"
    }
  }
}
